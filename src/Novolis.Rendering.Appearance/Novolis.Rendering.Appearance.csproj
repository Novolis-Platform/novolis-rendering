<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)..\..\build\Novolis.Rendering.Packaging.props" />
  <PropertyGroup>
    <RootNamespace>Novolis.Rendering.Appearance</RootNamespace>
    <AssemblyName>Novolis.Rendering.Appearance</AssemblyName>
    <PackageId>Novolis.Rendering.Appearance</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Declarative appearance stacks (surface, volume, light, effect, post) with a CPU evaluator. No host, no bitmaps required.</Description>
    <PackageTags>rendering;appearance;procedural;composition</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <LibraryReference Include="Novolis.Math.Geometry" />
  </ItemGroup>
</Project>
